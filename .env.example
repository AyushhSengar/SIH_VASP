# ==========================================================================
# BLOCKCHAIN VASP INVESTIGATION -- configuration
# ==========================================================================
# Copy this file to `.env` and fill in ETHERSCAN_API_KEY. Every value below
# is read by app/core/config.py::get_settings(); nothing in this project has
# a threshold hardcoded in its logic, so anything you can tune is here.
#
# Every setting is OPTIONAL except ETHERSCAN_API_KEY -- the defaults shown
# are the ones the code uses when a variable is unset, so an empty `.env`
# with only a key in it is a valid configuration.
#
# NEVER commit a filled-in `.env`. It is git-ignored for that reason. No key
# is ever written into a cache key, a log line, a report, or an API error
# body.
# ==========================================================================


# --------------------------------------------------------------------------
# PROVIDER CREDENTIALS -- the only required setting
# --------------------------------------------------------------------------
# Without this, live acquisition FAILS with a message naming this variable.
# It never falls back to demonstration or synthetic data: a report built from
# invented transactions is worse than no report. The two offline modes
# (`--cached-graph`, `--transfers-file`) do not need a key and label their
# output CACHED REAL DATA.
#
# Free key: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# Etherscan's V2 unified API: one host for every supported chain, selected by
# chainid. Adding another EVM chain is a config change, not a code change.
# Verify the current base URL and auth scheme at https://docs.etherscan.io
# before relying on these.
ETHERSCAN_BASE_URL=https://api.etherscan.io/v2/api
# OPTIONAL OVERRIDE -- normally leave this unset.
#
# The chain id is derived from the chain NAME (--chain / the API's "chain"
# field) by app/blockchain/chains.py, which is the single place that maps a
# name to an id. Setting it here pins the id independently of the name, and a
# value that contradicts the requested chain is rejected rather than honoured:
# querying chain 1 while every line of the report says "polygon" would produce
# real transactions labelled with a chain they did not come from.
#
# Its only real use is as a deployment assertion: pin the id you expect, and
# any run whose --chain resolves to a different one fails loudly instead of
# quietly investigating the wrong chain.
# ETHERSCAN_CHAIN_ID=1


# --------------------------------------------------------------------------
# ACQUISITION BOUNDS
# --------------------------------------------------------------------------
# Per-stream record ceiling (native, internal and token are counted
# separately). Reaching it marks the dataset INCOMPLETE rather than silently
# truncating it, so a negative finding on a busy wallet is never reported as
# proven absence.
MAX_TRANSACTIONS_PER_INVESTIGATION=2000
DEFAULT_LOOKBACK_DAYS=90
HTTP_TIMEOUT_SECONDS=15
# Retries cover rate limiting AND transient transport faults (timeouts,
# connection resets), with exponential backoff.
HTTP_MAX_RETRIES=3


# --------------------------------------------------------------------------
# RECURSIVE MULTI-HOP ACQUISITION
# --------------------------------------------------------------------------
# Live acquisition walks outward from the investigated wallet hop by hop,
# fetching each newly discovered counterparty's own transaction streams, so
# that a --max-hops 4 search runs against a graph that actually contains
# four hops of edges. Ethereum is one connected component, so these three
# numbers are all that stands between one wallet and the whole chain: they
# are hard ceilings, and whichever one bites is named in the report rather
# than silently applied.
#
# Total addresses fetched per investigation, INCLUDING the wallet itself. At
# roughly three to nine provider requests per address, 40 keeps a full run
# inside a couple of hundred requests, which the free Etherscan tier serves
# without tripping its rate limit.
EXPANSION_MAX_ADDRESSES=40
# Per-hop ceiling. Without it, one high-degree counterparty at hop 1 would
# consume the entire address budget at hop 2 and no deeper hop would ever be
# attempted.
EXPANSION_MAX_ADDRESSES_PER_HOP=30
# Per-stream record ceiling for an EXPANDED address, deliberately lower than
# MAX_TRANSACTIONS_PER_INVESTIGATION above, which stays reserved for the
# investigated wallet's own history. A counterparty is fetched to find onward
# routes, not to be investigated in its own right.
EXPANSION_MAX_RECORDS_PER_STREAM=1000


# --------------------------------------------------------------------------
# CACHES
# --------------------------------------------------------------------------
# Raw provider responses, keyed deterministically. The key never contains the
# API key. `--no-cache` bypasses reads and writes for one run; `--refresh`
# bypasses only reads, so stale entries are replaced rather than left behind.
PROVIDER_CACHE_ENABLED=true
PROVIDER_CACHE_DIR=data/cache/provider
PROVIDER_CACHE_TTL_SECONDS=86400

# Built transaction graphs (.gpickle), reloadable with `--cached-graph`.
# Tests point this at a temporary directory so a test run can never leave a
# graph behind that a later real investigation might load.
GRAPH_CACHE_DIR=data/graphs

# Normalized real transfer files (.json), reloadable with `--transfers-file`,
# and the first place the HTTP API looks for real data about a wallet. A run
# that reads one is CACHED REAL DATA, never REAL -- but unlike a reloaded
# graph it keeps per-record provenance, so the supervised labelling rules can
# run. Discovery is by the exact name `{wallet}_{chain}.json`; nothing that
# merely looks similar is ever loaded.
TRANSFERS_CACHE_DIR=data/fixtures


# --------------------------------------------------------------------------
# KNOWN-VASP DATASET
# --------------------------------------------------------------------------
# The production seed set. Every entry is a real, publicly documented address
# carrying its own provenance (official_disclosure / directly_verified /
# public_label / third_party_label / community_label / inferred /
# unverified). Addresses are deliberately NOT added to inflate the count --
# an unsourced address weakens every conclusion drawn from the file. Adding a
# new one is a pure JSON edit; no Python change is needed.
VASP_SEED_DATASET_PATH=data/seed/known_vasps.json

# Synthetic addresses, used ONLY by the legacy per-milestone scripts under
# an explicit `--demo` flag and by tests. `investigate.py` never loads this
# file, and any result derived from it is banner-marked as synthetic.
VASP_DEMO_SEED_DATASET_PATH=data/seed/demo_known_vasps.json

# Documented NON-VASP addresses: the negative class for the supervised
# `vasp_ownership` model. Absence from the seed set above is NOT evidence that
# an address is not VASP-controlled, so a negative label is only ever taken
# from this file, where each entry states its own reason and evidence type.
# Removing the file does not break anything -- it leaves that one ML task
# untrainable, which is reported honestly rather than worked around.
NON_VASP_REFERENCE_PATH=data/seed/non_vasp_reference.json


# --------------------------------------------------------------------------
# PERSISTENCE (HTTP API only -- the CLI does not use a database)
# --------------------------------------------------------------------------
# Defaults to a local SQLite file, so no server is needed for development or
# tests. Point at postgresql+psycopg2:// to use PostgreSQL; SQLAlchemy picks
# the driver from the scheme. This value may contain credentials, so it is
# never included in any caller-visible output.
DATABASE_URL=sqlite:///./data/blockchain_intel.db


# --------------------------------------------------------------------------
# HTTP API (browser access)
# --------------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API. The React
# frontend in /frontend runs on Vite's dev server (5173), which is a different
# origin from the API, so without this every request from it fails preflight.
# Deliberately NOT "*": this API is unauthenticated, and a wildcard would let
# any page the operator happens to have open drive investigations against this
# deployment. Set it to the frontend's real origin when deploying it elsewhere,
# or to nothing at all to refuse browser callers entirely.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# --------------------------------------------------------------------------
# FUND-FLOW TRACING
# --------------------------------------------------------------------------
# Path length in hops. Raising this grows the search super-linearly; prefer
# the targeted (destination-aware) search below to raising these.
FUND_TRACE_MAX_HOPS=4
FUND_TRACE_MAX_PATHS=500
FUND_TRACE_MAX_EDGES_EXPLORED=20000
# Only consider transfers within this many days of the wallet's most recent
# activity. 0 = no window (the `--time-window` flag overrides this per run).
FUND_TRACE_TIME_WINDOW_DAYS=0

# Targeted search: instead of enumerating everything reachable, search TOWARD
# the known VASP addresses only, in both directions. This is what makes a
# 50k-edge graph tractable, and why the budgets above do not need raising.
# Exhausting a budget yields SEARCH STATUS: INCONCLUSIVE, never "NONE".
TARGETED_TRACE_MAX_PATHS_PER_TARGET=25
TARGETED_TRACE_MAX_EDGES_EXPLORED=400000

# Path plausibility. A route through a 10k-degree exchange hot wallet is a
# graph path, not evidence of fund continuity; a 30-day gap between hops is
# weaker still. Both are reported as caveats on the path, not used to hide it.
PATH_QUALITY_HUB_DEGREE_THRESHOLD=100
PATH_QUALITY_MAX_HOP_GAP_SECONDS=2592000


# --------------------------------------------------------------------------
# BEHAVIOURAL INDICATORS
# --------------------------------------------------------------------------
# Each threshold below is printed next to the value actually observed, so a
# finding can always be checked. These are INVESTIGATIVE INDICATORS -- none
# of them is evidence of wrongdoing, and none is labelled as criminal.

# Fan-out / fan-in: distinct counterparties in one direction.
BEHAVIOR_MIN_FANOUT_COUNTERPARTIES=4
BEHAVIOR_MIN_FANIN_COUNTERPARTIES=4

# Frequency and bursts.
BEHAVIOR_HIGH_FREQUENCY_MIN_TRANSFERS=5
BEHAVIOR_BURST_WINDOW_SECONDS=3600
BEHAVIOR_BURST_MIN_TRANSFERS=5
BEHAVIOR_ACTIVITY_DENSITY_MIN_PER_DAY=20.0
BEHAVIOR_ACTIVITY_DENSITY_MIN_TRANSFERS=20

# Rapid movement and pass-through (in, then straight back out).
BEHAVIOR_RAPID_HOP_MAX_SECONDS=300
BEHAVIOR_FAST_PASSTHROUGH_MAX_SECONDS=600
BEHAVIOR_FORWARDING_WINDOW_SECONDS=3600
BEHAVIOR_MIN_FORWARDING_EVENTS=2

# Counterparty concentration: share of volume with a single counterparty.
BEHAVIOR_COUNTERPARTY_CONCENTRATION_MIN_SHARE=0.5
BEHAVIOR_CONCENTRATION_MIN_TRANSFERS=5

# Assets and amounts.
BEHAVIOR_MIN_ASSET_DIVERSITY=4
BEHAVIOR_REPEATED_AMOUNT_MIN_OCCURRENCES=3
# Decimal places at which two amounts count as "the same". Deliberately
# generous: rounding to 2dp would call 1.001 and 1.009 identical.
BEHAVIOR_REPEATED_AMOUNT_DECIMALS=8
BEHAVIOR_LARGE_VALUE_NATIVE_AMOUNT=100.0

# Dormancy then reactivation.
BEHAVIOR_DORMANCY_MIN_SECONDS=2592000
BEHAVIOR_REACTIVATION_WINDOW_SECONDS=86400
BEHAVIOR_REACTIVATION_MIN_TRANSFERS=3

# Timing. Hours are UTC: a wallet is not "nocturnal" without knowing where
# its operator is, so this is reported as a UTC observation, not an inference
# about a person.
BEHAVIOR_UNUSUAL_HOUR_START_UTC=0
BEHAVIOR_UNUSUAL_HOUR_END_UTC=5
BEHAVIOR_UNUSUAL_TIMING_MIN_SHARE=0.5
BEHAVIOR_UNUSUAL_TIMING_MIN_TRANSFERS=5

# In/out balance: how close inbound and outbound volume are.
BEHAVIOR_IN_OUT_IMBALANCE_MIN_RATIO=0.8
BEHAVIOR_IN_OUT_IMBALANCE_MIN_TRANSFERS=5


# --------------------------------------------------------------------------
# RISK SCORING
# --------------------------------------------------------------------------
# The score is a sum of named, individually printed components -- there is no
# opaque "risk = 87" anywhere. Change a weight and the report's arithmetic
# changes with it, visibly.
RISK_WEIGHT_DIRECT_VASP_EVIDENCE=25.0
RISK_WEIGHT_INDIRECT_VASP_EVIDENCE=15.0
RISK_WEIGHT_INVESTIGATIVE_INDICATOR=6.0
RISK_WEIGHT_SUPPORTING_INDICATOR=3.0
RISK_WEIGHT_CONTEXTUAL_INDICATOR=1.0
# Added when a search hit a budget, because an incomplete search is itself a
# reason to treat a negative finding with caution.
RISK_WEIGHT_INCOMPLETE_SEARCH=5.0

RISK_BAND_MEDIUM_THRESHOLD=20.0
RISK_BAND_HIGH_THRESHOLD=45.0


# --------------------------------------------------------------------------
# MACHINE LEARNING
# --------------------------------------------------------------------------
# Trained artifacts, feature/label schema versions and metrics.
ML_ARTIFACT_DIR=data/ml
# Fixed so a run is reproducible; recorded on every prediction.
ML_RANDOM_SEED=42
ML_TEST_FRACTION=0.2
ML_VALIDATION_FRACTION=0.2
ML_CV_FOLDS=5

# The refusal threshold, and the most important ML setting here. Below this
# many labelled samples PER CLASS, training is REFUSED and no metric is
# reported -- the report prints the blockers instead. Labels are never
# invented to get past it: in particular an address absent from the seed set
# is never labelled NOT_VASP_OWNED, so with the current 6-address dataset the
# supervised VASP task is legitimately untrainable and the pipeline falls back
# to a labelled-data-free unsupervised outlier analysis and says so.
ML_MIN_SAMPLES_PER_CLASS=20
# Activity floor for the sampling frame, applied BEFORE any label is read so
# it cannot admit one class more readily than another.
ML_MIN_TRANSFERS_PER_SAMPLE=3
